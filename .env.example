# --------------------------------------------
# REQUIRED: BASIC APP SETTINGS
# --------------------------------------------
NODE_ENV=production
PORT=8000

# --------------------------------------------
# REQUIRED: DATABASE SETTINGS
# --------------------------------------------
DATABASE_URL=postgresql://postgres:123@localhost:5432/eagle_cement?schema=public

# --------------------------------------------
# OPTIONAL: SECURITY HEADER SETTINGS
# --------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --------------------------------------------
# REQUIRED: AUTH SETTINGS
# --------------------------------------------
JWT_SECRET=your-jwt-secret-here

# --------------------------------------------
# OPTIONAL: CCTV / ANPR INTEGRATION
# --------------------------------------------
# go2rtc WebRTC/API gateway (RTSP -> WHEP + snapshot frames).
GO2RTC_API_URL=http://127.0.0.1:1984
# ANPR microservice (plate detection + OCR) used for live-preview detection.
ANPR_SERVICE_URL=http://127.0.0.1:9137

# --------------------------------------------
# RESEND
# --------------------------------------------
RESEND_API_KEY=null
RESEND_FROM_EMAIL=System <onboarding@resend.dev>
RESEND_VERIFY_TEMPLATE_ID=null
RESEND_EAGLE_CEMENT_TEMPLATE_ID=eagle-cement
# Comma-separated reviewers that receive auto-sent alerts for non-VERIFIED transactions. Empty = off.
TRANSACTION_ALERT_RECIPIENTS=operations@geosense.biz
