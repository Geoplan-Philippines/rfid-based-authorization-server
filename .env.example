# --------------------------------------------
# REQUIRED: BASIC APP SETTINGS
# --------------------------------------------
NODE_ENV=production
PORT=8000

# --------------------------------------------
# REQUIRED: DATABASE SETTINGS
# --------------------------------------------
DATABASE_URL=postgresql://postgres:123@localhost:5432/eagle_cement?schema=public

# --------------------------------------------
# OPTIONAL: SECURITY HEADER SETTINGS
# --------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --------------------------------------------
# REQUIRED: AUTH SETTINGS
# --------------------------------------------
JWT_SECRET=your-jwt-secret-here

# --------------------------------------------
# RESEND
# --------------------------------------------
RESEND_API_KEY=null
RESEND_FROM_EMAIL=System <onboarding@resend.dev>
RESEND_VERIFY_TEMPLATE_ID=null
RESEND_EAGLE_CEMENT_TEMPLATE_ID=eagle-cement
# Comma-separated reviewers that receive auto-sent alerts for non-VERIFIED transactions. Empty = off.
TRANSACTION_ALERT_RECIPIENTS=operations@geosense.biz

# --------------------------------------------
# FACE RECOGNITION — SERVICE
# --------------------------------------------
FACE_RECOGNITION_ENABLED=true
# OFF | SHADOW | ACTIVE. Start at SHADOW and stay there until enrollment coverage is high.
FACE_ENFORCEMENT_MODE=SHADOW
FACE_SERVICE_BASE_URL=http://127.0.0.1:8001
FACE_SERVICE_API_KEY=<generate: openssl rand -hex 32>
FACE_SERVICE_TIMEOUT_MS=8000
FACE_SERVICE_RETRY_ATTEMPTS=1

# --------------------------------------------
# FACE RECOGNITION — MODEL PINNING
# Changing either invalidates every stored embedding. Re-enrollment of 2 000 people.
# --------------------------------------------
FACE_EMBEDDING_PROVIDER=DEEPFACE
FACE_EMBEDDING_MODEL=ARCFACE
FACE_EMBEDDING_DIMENSIONS=512

# --------------------------------------------
# FACE RECOGNITION — MATCHING THRESHOLDS
# Cosine distance. Tightened for a ~2 000-identity gallery. Retune from SHADOW data.
# --------------------------------------------
FACE_MATCH_THRESHOLD=0.45
FACE_MATCH_MARGIN=0.08
FACE_LOW_CONFIDENCE_BAND=0.08
FACE_MIN_QUALITY_SCORE=0.5
FACE_MIN_LIVENESS_SCORE=0.6
FACE_LIVENESS_ENABLED=true
FACE_LIVENESS_DISABLE_IN_IR=true

# --------------------------------------------
# FACE RECOGNITION — GATE CAPTURE WINDOW
# The driver stops, lowers the window and leans out. That takes seconds, so the
# capture WAITS for a face rather than firing a fixed burst.
# --------------------------------------------
FACE_GATE_CAMERA_ID=GATE-IN-FACE
FACE_GATE_FRAME_COUNT=5
FACE_GATE_MIN_VOTES=3
FACE_GATE_CAPTURE_TIMEOUT_MS=20000
FACE_GATE_LOOKBACK_MS=1000
FACE_GATE_SAMPLE_FPS=5
FACE_GATE_POLL_INTERVAL_MS=500
# Default false = current behaviour: a valid tag auto-opens the barrier at the end of
# the pipeline even on a face mismatch. Set true ONLY once accuracy justifies it.
FACE_BLOCK_BARRIER_ON_MISMATCH=false

# --------------------------------------------
# FACE RECOGNITION — ENROLLMENT
# --------------------------------------------
FACE_ENROLLMENT_ANGLES=FRONT,DOWN,LEFT,RIGHT
FACE_ENROLLMENT_ENFORCE_ORDER=true
FACE_ENROLLMENT_RANDOMIZE_ORDER=false
FACE_ENROLLMENT_STEP_TIMEOUT_MS=30000
FACE_ENROLLMENT_MIN_IPD_PX=90
FACE_ENROLLMENT_MIN_SHARPNESS=120
FACE_ENROLLMENT_MIN_QUALITY_SCORE=0.6
FACE_ENROLLMENT_MIN_LIVENESS_SCORE=0.7
FACE_ENROLLMENT_DUPLICATE_THRESHOLD=0.40
FACE_ENROLLMENT_COHERENCE_THRESHOLD=0.70
# Deferred per scope decision. Columns exist; flip to true to enforce.
FACE_ENROLLMENT_CONSENT_REQUIRED=false

# --------------------------------------------
# FACE RECOGNITION — STORAGE & RETENTION
# --------------------------------------------
MAX_FACE_UPLOAD_BYTES=4194304
FACE_SNAPSHOT_RETENTION_DAYS=90
FACE_ENROLLMENT_RETENTION_DAYS=30
FACE_PURGE_CRON=0 3 * * *

# --------------------------------------------
# FACE RECOGNITION — ALERTS
# Suppress the non-VERIFIED alert email when the ONLY problem is a face mismatch.
# Mandatory while enrolling 2 000 people incrementally.
# --------------------------------------------
FACE_SUPPRESS_MISMATCH_ALERTS=true
