// Notes for AI / Contributors:
// For fucks sake dipshit,
// Follow existing formatting, (alignment, spacing, ordering)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id                            String                    @id @default(uuid())
  firstName                     String?                   @map("first_name")
  lastName                      String?                   @map("last_name")
  email                         String                    @unique
  password                      String
  role                          Role                      @default(ADMIN)
  isArchived                    Boolean                   @default(false) @map("is_archived")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@map("users")
}

model ApiKey {
  id                            String                    @id @default(uuid())
  name                          String
  keyHash                       String                    @unique @map("key_hash")
  prefix                        String
  lastUsedAt                    DateTime?                 @map("last_used_at")
  revokedAt                     DateTime?                 @map("revoked_at")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@map("api_keys")
}

model Driver {
  id                            String                    @id @default(uuid())
  firstName                     String                    @map("first_name")
  lastName                      String                    @map("last_name")
  licenseNumber                 String                    @unique @map("license_number")
  photoUrl                      String?                   @map("photo_url")
  isArchived                    Boolean                   @default(false) @map("is_archived")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  truckAssignments              TruckDriverAssignment[]
  gateEvents                    GateEvent[]
  faceProfile                   FaceProfile?
  faceRecognitionAttempts       FaceRecognitionAttempt[]

  @@map("drivers")
}

model Truck {
  id                            String                    @id @default(uuid())
  plateNumber                   String                    @unique @map("plate_number")
  model                         String?
  photoUrl                      String?                   @map("photo_url")
  isArchived                    Boolean                   @default(false) @map("is_archived")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  rfidTag                       RFIDTag?
  driverAssignments             TruckDriverAssignment[]
  gateEvents                    GateEvent[]

  @@map("trucks")
}

model TruckDriverAssignment {
  status                        TruckDriverAssignmentStatus    @default(ACTIVE)
  role                          AssignmentRole                 @default(RELIEF)

  truckId                       String                         @map("truck_id")
  truck                         Truck                          @relation(fields: [truckId], references: [id], onDelete: Cascade)

  driverId                      String                         @map("driver_id")
  driver                        Driver                         @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                       @default(now()) @map("created_at")
  updatedAt                     DateTime                       @updatedAt @map("updated_at")

  @@id([truckId, driverId])
  @@index([driverId])
  @@map("truck_driver_assignments")
}

model RFIDTag {
  id                            String                    @id @default(uuid())
  epcId                         String                    @unique @map("epc_id")
  serialNo                      String?                   @unique @map("serial_no")
  status                        RFIDTagStatus             @default(ACTIVE)

  assignedTruckId               String?                   @unique @map("assigned_truck_id")
  assignedTruck                 Truck?                    @relation(fields: [assignedTruckId], references: [id])

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  gateEvents                    GateEvent[]
  statusHistory                 RFIDTagStatusHistory[]

  @@map("rfid_tags")
}

model RFIDTagStatusHistory {
  id                            String                    @id @default(uuid())
  fromStatus                    RFIDTagStatus?            @map("from_status")
  toStatus                      RFIDTagStatus             @map("to_status")
  reason                        String?
  changedById                   String?                   @map("changed_by_id")

  rfidTagId                     String                    @map("rfid_tag_id")
  rfidTag                       RFIDTag                   @relation(fields: [rfidTagId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([rfidTagId])
  @@map("rfid_tag_status_history")
}

model AuditLog {
  id                            String                    @id @default(uuid())
  actorId                       String?                   @map("actor_id")
  action                        String
  entityType                    String                    @map("entity_type")
  entityId                      String                    @map("entity_id")
  metadata                      Json?
  createdAt                     DateTime                  @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model EventVerification {
  id                            String                    @id @default(uuid())
  rfidMatched                   Boolean                   @map("rfid_matched")
  faceMatched                   Boolean?                  @map("face_matched")
  plateMatched                  Boolean?                  @map("plate_matched")
  faceConfidence                Float?                    @map("face_confidence")
  plateConfidence               Float?                    @map("plate_confidence")
  verifiedAt                    DateTime                  @default(now()) @map("verified_at")

  gateEventId                   String                    @unique @map("gate_event_id")
  gateEvent                     GateEvent                 @relation(fields: [gateEventId], references: [id])

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@map("event_verifications")
}

model GateEvent {
  id                            String                    @id @default(uuid())
  eventCode                     String                    @unique @map("event_code")
  plateNumberRead               String?                   @map("plate_number_read")
  result                        GateEventResult
  occurredAt                    DateTime                  @default(now()) @map("occurred_at")

  rfidTagId                     String?                   @map("rfid_tag_id")
  rfidTag                       RFIDTag?                  @relation(fields: [rfidTagId], references: [id])

  truckId                       String?                   @map("truck_id")
  truck                         Truck?                    @relation(fields: [truckId], references: [id])

  driverId                      String?                   @map("driver_id")
  driver                        Driver?                   @relation(fields: [driverId], references: [id])

  verification                  EventVerification?
  snapshots                     GateSnapshot[]
  timeline                      GateTimelineEvent[]
  faceRecognitionAttempts       FaceRecognitionAttempt[]

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([occurredAt])
  @@index([result])
  @@index([truckId])
  @@index([driverId])
  @@index([rfidTagId])
  @@index([plateNumberRead])
  @@map("gate_events")
}

model GateSnapshot {
  id                            String                    @id @default(uuid())
  imageUrl                      String                    @map("image_url")
  type                          SnapshotType

  gateEventId                   String                    @map("gate_event_id")
  gateEvent                     GateEvent                 @relation(fields: [gateEventId], references: [id])

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([gateEventId])
  @@index([type])
  @@map("gate_snapshots")
}

model GateTimelineEvent {
  id                            String                    @id @default(uuid())
  type                          TimelineEventType
  message                       String?
  metadata                      Json?
  occurredAt                    DateTime                  @map("occurred_at")

  gateEventId                   String                    @map("gate_event_id")
  gateEvent                     GateEvent                 @relation(fields: [gateEventId], references: [id])

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([gateEventId])
  @@index([type])
  @@map("gate_timeline_events")
}

model FaceProfile {
  id                            String                    @id @default(uuid())
  status                        FaceProfileStatus         @default(PENDING)
  consentGivenAt                DateTime?                 @map("consent_given_at")
  consentReference              String?                   @map("consent_reference")
  enrolledAt                    DateTime?                 @map("enrolled_at")
  enrolledById                  String?                   @map("enrolled_by_id")
  disabledAt                    DateTime?                 @map("disabled_at")
  disabledReason                String?                   @map("disabled_reason")
  isArchived                    Boolean                   @default(false) @map("is_archived")

  driverId                      String                    @unique @map("driver_id")
  driver                        Driver                    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  faceEmbeddings                FaceEmbedding[]

  @@index([status])
  @@index([isArchived])
  @@map("face_profiles")
}

model FaceEmbedding {
  id                            String                    @id @default(uuid())
  angle                         FaceAngle
  provider                      FaceEmbeddingProvider     @default(DEEPFACE)
  model                         FaceEmbeddingModel        @default(ARCFACE)
  embedding                     Unsupported("vector(512)")
  imageUrl                      String                    @map("image_url")
  qualityScore                  Float?                    @map("quality_score")
  livenessScore                 Float?                    @map("liveness_score")
  yaw                           Float?
  pitch                         Float?
  isArchived                    Boolean                   @default(false) @map("is_archived")

  faceProfileId                 String                    @map("face_profile_id")
  faceProfile                   FaceProfile               @relation(fields: [faceProfileId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  // No HNSW index — deliberate. Exact sequential scan is ~5-10ms at the confirmed 2 000-driver /
  // 8 000-embedding scale (100% recall). HNSW is approximate and can flip a true match into a
  // false non-match. Do not add one reflexively in review; see docs/face/plan/04-data-model.md §4.3.
  @@index([faceProfileId])
  @@index([provider, model])
  @@index([isArchived])
  @@map("face_embeddings")
}

model FaceRecognitionAttempt {
  id                            String                    @id @default(uuid())
  outcome                       FaceRecognitionOutcome
  enforcementMode               FaceEnforcementMode       @map("enforcement_mode")
  cameraId                      String?                   @map("camera_id")
  distance                      Float?
  similarity                    Float?
  margin                        Float?
  livenessScore                 Float?                    @map("liveness_score")
  qualityScore                  Float?                    @map("quality_score")
  framesCaptured                Int                       @default(0) @map("frames_captured")
  framesUsable                  Int                       @default(0) @map("frames_usable")
  votes                         Int                       @default(0)
  snapshotUrl                   String?                   @map("snapshot_url")
  latencyMs                     Int?                      @map("latency_ms")
  errorCode                     String?                   @map("error_code")
  reviewedById                  String?                   @map("reviewed_by_id")
  reviewedOutcome               FaceReviewOutcome?        @map("reviewed_outcome")
  reviewedAt                    DateTime?                 @map("reviewed_at")

  matchedDriverId               String?                   @map("matched_driver_id")
  matchedDriver                 Driver?                   @relation(fields: [matchedDriverId], references: [id])

  gateEventId                   String?                   @map("gate_event_id")
  gateEvent                     GateEvent?                @relation(fields: [gateEventId], references: [id], onDelete: Cascade)

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@index([gateEventId])
  @@index([matchedDriverId])
  @@index([outcome])
  @@index([createdAt])
  @@map("face_recognition_attempts")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

enum RFIDTagStatus {
  ACTIVE
  INACTIVE
  LOST
  BLOCKED
  RETIRED
}

enum TruckDriverAssignmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AssignmentRole {
  PRIMARY
  RELIEF
}

enum GateEventResult {
  VERIFIED
  UNKNOWN_TAG
  FACE_MISMATCH
  PLATE_MISMATCH
  MANUAL_OVERRIDE
  DENIED
  ERROR
}

enum SnapshotType {
  FACE
  PLATE
  WIDE
}

enum TimelineEventType {
  RFID_SCANNED
  TAG_VALIDATED
  PLATE_CAPTURED
  PLATE_MATCHED
  FACE_CAPTURED
  FACE_MATCHED
  BARRIER_OPENED
  MANUAL_OVERRIDE
}

enum FaceProfileStatus {
  PENDING
  ACTIVE
  DISABLED
  NEEDS_REENROLLMENT
}

enum FaceAngle {
  FRONT
  DOWN
  LEFT
  RIGHT
}

enum FaceEmbeddingProvider {
  DEEPFACE
  INSIGHTFACE
}

enum FaceEmbeddingModel {
  ARCFACE
  FACENET512
  SFACE
}

enum FaceEnforcementMode {
  OFF
  SHADOW
  ACTIVE
}

enum FaceRecognitionOutcome {
  MATCHED
  NO_MATCH
  LOW_CONFIDENCE
  AMBIGUOUS
  NO_FACE_DETECTED
  POOR_QUALITY
  SPOOF_DETECTED
  SERVICE_ERROR
}

enum FaceReviewOutcome {
  CONFIRMED_CORRECT
  CONFIRMED_WRONG
  UNCLEAR
}
